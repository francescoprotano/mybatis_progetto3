<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="it.exolab.mapper.ClienteMapper">

  <insert id="insert" parameterType="it.exolab.model.Cliente"
  		useGeneratedKeys="true"
    	keyProperty="id"
  		keyColumn="id"
  >
    insert into cliente (nome,cognome,indirizzo,citta,telefono) values (#{nome},#{cognome},#{indirizzo},#{citta},#{telefono}) 
  </insert>
  
  
  
   <select id="findAll" resultType="it.exolab.model.Cliente" 
  	
  >
    select * from cliente order by cognome asc
  </select>
  
  
  

  
</mapper>