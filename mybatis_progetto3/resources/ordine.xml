<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="it.exolab.mapper.OrdineMapper">

  <insert id="insert" parameterType="it.exolab.model.Ordine"
  		useGeneratedKeys="true"
    	keyProperty="id"
  		keyColumn="id"
  >
    insert into ordine (data_ordine,id_cliente,id_prodotto,prezzo_acquisto,quantita_acquista,stato_lavorazione) 
    values (
    now(),#{id_cliente},#{id_prodotto},#{prezzo_acquisto},#{quantita_acquista},1) 
  </insert>
  
  
  
   <delete id="delete"  
  	parameterType="Long"
  >
    delete from ordine where id = #{id}   
  </delete>
  
   <select id="findAll" resultType="it.exolab.model.Ordine" 
  	
  >
    select * from ordine order by id asc
  </select>
  
  
  

  
</mapper>